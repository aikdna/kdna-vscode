{
  "name": "kdna-vscode",
  "displayName": "KDNA Developer Tools",
  "description": "Edit and diagnose KDNA project views, inspect explicit assets, and manage visible approved workspace attachments through the official CLI.",
  "version": "0.2.0",
  "publisher": "aikdna",
  "license": "Apache-2.0",
  "icon": "media/kdna-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace attachment controls execute an explicitly configured local CLI and remain disabled until the workspace is trusted.",
      "restrictedConfigurations": [
        "kdna.workspaceCliEntry"
      ]
    }
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "kdna",
    "ai-agent",
    "domain-judgment",
    "judgment-asset",
    "kdna-core",
    "ai-agent-runtime",
    "official-toolchain"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onCommand:kdna.validate",
    "onCommand:kdna.pack",
    "onCommand:kdna.unpack",
    "onCommand:kdna.preview",
    "onCommand:kdna.install",
    "onCommand:kdna.workspaceStatus",
    "onCommand:kdna.workspaceAttach",
    "workspaceContains:.kdna/attachments.json",
    "onView:kdna-domains"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kdna-json",
        "extensions": [
          ".kdna"
        ],
        "aliases": [
          "KDNA Domain Asset"
        ],
        "icon": {
          "light": "media/kdna-icon.svg",
          "dark": "media/kdna-icon.svg"
        }
      }
    ],
    "commands": [
      {
        "command": "kdna.validate",
        "title": "KDNA: Validate Project View (Technical)"
      },
      {
        "command": "kdna.pack",
        "title": "KDNA: Pack Project View (Not Creation Complete)"
      },
      {
        "command": "kdna.unpack",
        "title": "KDNA: Unpack .kdna"
      },
      {
        "command": "kdna.preview",
        "title": "KDNA: Preview Structure (Technical)"
      },
      {
        "command": "kdna.install",
        "title": "KDNA: Open Local .kdna Asset"
      },
      {
        "command": "kdna.workspaceStatus",
        "title": "KDNA: Workspace Attachments"
      },
      {
        "command": "kdna.workspaceAttach",
        "title": "KDNA: Attach File to Workspace"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "kdna-domains",
          "name": "KDNA Domains",
          "icon": "media/kdna-icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kdna-domains",
        "contents": "No expanded KDNA project views found in this workspace.\nCreation requires a separately installed compatible KDNA Studio CLI; this extension does not generate project views.\n[Open Local .kdna Asset](command:kdna.install)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kdna.workspaceStatus",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "kdna.workspaceAttach",
          "when": "isWorkspaceTrusted"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceFilename == kdna.json || resourceExtname == .kdna",
          "command": "kdna.preview",
          "group": "navigation"
        },
        {
          "when": "resourceFilename == kdna.json",
          "command": "kdna.validate",
          "group": "navigation"
        },
        {
          "when": "resourceFilename == kdna.json",
          "command": "kdna.pack",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "KDNA",
      "properties": {
        "kdna.scanDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum directory depth to scan for expanded KDNA project views. Increase for deep monorepo structures."
        },
        "kdna.workspaceCliEntry": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Absolute path to the exact @aikdna/kdna-cli 0.36.0 src/cli.js entry used for workspace attachment status and controls. Empty disables the candidate workspace integration."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "webpack --mode production",
    "lint": "eslint src --ext ts",
    "test": "node scripts/check-public-current-surface.mjs && node --test test/public-current-surface.test.js && node scripts/verify-core-candidate-contract.mjs && node --test test/core-candidate-gate.test.js && npm run compile && node --test out/test/unit/*.test.js test/release-policy.test.js",
    "test:integration": "npm run compile && npm run build && node out/test/runTest.js",
    "package": "vsce package",
    "release:check": "node scripts/verify-release-guard.mjs && node scripts/release-check.js",
    "test:gate": "node scripts/verify-core-candidate-contract.mjs && node --test test/core-candidate-gate.test.js",
    "provenance": "node scripts/verify-core-candidate-contract.mjs --core-repo ${KDNA_CORE_REPO:?$KDNA_CORE_REPO must be set} && node --test test/provenance-gate.test.js"
  },
  "dependencies": {
    "@aikdna/kdna-core": "0.21.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "10.8.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "@eslint/js": "10.0.1"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.5",
    "brace-expansion": "5.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aikdna/kdna-vscode.git"
  },
  "homepage": "https://aikdna.com"
}
